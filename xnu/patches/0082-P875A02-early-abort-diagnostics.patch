Temporary diagnostics for the first hardware bring-up:
 - print FAR/ESR/ELR for an unclassified kernel data abort;
 - bracket PE_create_console / PE_init_printf / cpu_machine_idle_init /
   PE_init_platform and P875A02_ufs_init with kprintf markers;
 - print the /pram physical address and mapped KVA, the boot video base and
   the fbcon physical address / mapped KVA.

--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1629,7 +1629,9 @@
 		panic_with_thread_kernel_state("Kernel parity error.", state);
 #endif
 	} else {
-		kprintf("Unclassified kernel abort (fault_code=0x%x)\n", fault_code);
+		kprintf("Unclassified kernel abort (fault_code=0x%x) far=%#llx esr=%#x elr=%#llx\n",
+		    fault_code, (unsigned long long)fault_addr, esr,
+		    (unsigned long long)get_saved_state_pc(state));
 	}
 
 	panic_with_thread_kernel_state("Kernel data abort.", state);
