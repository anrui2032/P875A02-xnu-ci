P875A02: implement AKS wrap/unwrap and the datamigrator selectors.

securityd retries kAKSWrapKey (10) on every failure, which spams the console and
trips the CPU wake budget; datamigrator asks for 93 and 34. Wrap/unwrap are an
identity transform (consistent in both directions), 34 answers zero and 93
returns a zeroed 4 KiB blob.

--- a/iokit/Kernel/arm/P875A02KeyStore.cpp
+++ b/iokit/Kernel/arm/P875A02KeyStore.cpp
@@ -50,6 +50,8 @@
 	kAKSNotifyStateIsSet = 103,
 	kAKSAssertConsume    = 101,     /* aks_assert_consume */
 	kAKSIdentityCreateFirst = 118, /* aks_identity_create_first (usermanagerd) */
+	kAKSMigrateGet      = 34,      /* datamigrator (2 scalars in, 1 out) */
+	kAKSMigrateBlob     = 93,      /* datamigrator (1 scalar in, 4 KiB out) */
 	kAKSLoadIdentity    = 120,     /* aks_load_identity (usermanagerd) */
 	kAKSGetPrimaryIdentity = 125,  /* aks_get_primary_identity (usermanagerd) */
 	kAKSIdentitySetPrimary = 126,  /* aks_identity_set_primary (usermanagerd) */
@@ -353,6 +355,38 @@
 			ret = kIOReturnNoSpace;
 		}
 		break;
