+		}
+		if (out_scalars > 0) {
+			args->scalarOutput[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		if (P875A02_aks_copyout(args, buf, n) == 0) {
+			ret = kIOReturnNoSpace;
+		}
+		break;
+	}
+	case kAKSMigrateGet:
+		if (out_scalars > 0) {
+			args->scalarOutput[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		break;
+	case kAKSMigrateBlob: {
+		uint8_t zeros[4096];
+		bzero(zeros, sizeof(zeros));
+		if (P875A02_aks_copyout(args, zeros, sizeof(zeros)) == 0) {
+			ret = kIOReturnNoSpace;
+		}
+		break;
