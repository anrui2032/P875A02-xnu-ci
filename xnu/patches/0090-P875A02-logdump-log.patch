P875A02: write the persistent console log to logdump on LUN 4.

logdump is a 512 MiB partition on UFS LUN 4 starting at 4K LBA 446579 (not on
the userdata LUN 0), so the old write to the tail of the root partition never
reached it. The log uses a raw WRITE(10) helper that switches the COMMAND UPIU
LUN, and writes a valid SWEETLOG header as soon as the thread starts.

--- a/bsd/dev/P875A02_ufs.c
+++ b/bsd/dev/P875A02_ufs.c
@@ -71,6 +71,14 @@
 
 #define UFS_BLOCK       4096u
 #define BOUNCE_SIZE     (1u << 20)
+/*
+ * logdump lives on LUN 4 (GeekFlashTool: start sector 446579, 512 MiB, 4K
+ * units), not on the userdata LUN 0. ufs_write_blocks only serves LUN 0, so
+ * the log uses a small raw helper that switches the COMMAND UPIU LUN.
+ */
+#define P875A02_LOGDUMP_LUN       4
+#define P875A02_LOGDUMP_LBA       446579ULL
+#define P875A02_LOGDUMP_BLOCKS    (512ull * 1024 * 1024 / UFS_BLOCK)
 #define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
 #define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
 #define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
@@ -292,6 +300,26 @@
 	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
 }
 
+/* WRITE(10) to an arbitrary LUN/LBA: only the logdump log uses this. */
+static int
+ufs_write_blocks_lun(uint8_t lun, uint64_t lba, uint32_t count)
+{
+	if (!su.writable || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba + count - 1 > UINT32_MAX) {
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	uint8_t saved = su.lun;
+	su.lun = lun;
+	int error = ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+	su.lun = saved;
+	return error;
+}
+
 static int
 ufs_sync_cache(void)
 {
@@ -300,6 +328,16 @@
 }
 
 static int
+ufs_sync_cache_lun(uint8_t lun)
+{
+	uint8_t saved = su.lun;
+	su.lun = lun;
+	int error = ufs_sync_cache();
+	su.lun = saved;
+	return error;
+}
