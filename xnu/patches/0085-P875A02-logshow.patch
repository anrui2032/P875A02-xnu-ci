P875A02: "P875A02logshow=1" prints the tail of the previous persistent
console log through the UFS driver and parks, so the text stays on the
framebuffer. Before showing, log_start writes a marker to the spare block
just before the log (read/write/read-back, real header untouched) and
prints the kernel_thread_start result.

--- a/bsd/dev/P875A02_ufs.c
+++ b/bsd/dev/P875A02_ufs.c
@@ -786,6 +786,66 @@
 	}
 }
 
+/*
+ * "P875A02logshow=1": print the tail of the previous boot's persistent log
+ * before anything overwrites it, then park the caller so the text stays on
+ * the framebuffer. Reads through the normal UFS driver (init, DMA, timeouts)
+ * instead of a shim-side SCSI path.
+ */
+static void
+P875A02_log_show(void)
+{
+	uint64_t base = su.first_block + su.nblocks - P875A02_LOG_BLOCKS;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	struct P875A02_log_header h;
+
+	printf("P875A02 LOG: show base=0x%llx nblocks=0x%llx\n", base, su.nblocks);
+	int rdh = ufs_read_blocks(base, 1);
+	uint32_t *w = (uint32_t *)bounce;
+	printf("P875A02 LOG: show read=%d hdr %08x %08x %08x %08x\n",
+	    rdh, w[0], w[1], w[2], w[3]);
+	if (rdh) {
+		return;
+	}
+	memcpy(&h, bounce, sizeof(h));
+	if (memcmp(h.magic, "SWEETLOG", 8) != 0) {
+		printf("P875A02 LOG: show: no SWEETLOG header\n");
+		return;
+	}
+	uint64_t total = h.total;
+	uint32_t want = total > 16384 ? 16384 : (uint32_t)total;
+	uint64_t start = total - want;
+	printf("P875A02 LOG: show total=%llu len=%u\n", total, want);
+
+	char line[128];
+	uint32_t n = 0, cached = 0xffffffff;
+	for (uint64_t pos = start; pos < total; pos++) {
+		uint32_t off = (uint32_t)(pos % P875A02_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		if (blk != cached) {
+			if (ufs_read_blocks(base + 1 + blk, 1))
+				break;
+			cached = blk;
+		}
+		char c = ((const char *)bounce)[off % UFS_BLOCK];
+		if (c == '\r')
+			continue;
+		if (c == '\n' || n == sizeof(line) - 1) {
+			line[n] = 0;
+			printf("%s\n", line);
+			n = 0;
+			if (c == '\n')
+				continue;
+		}
+		if (c >= 0x20 && c < 0x7f)
+			line[n++] = c;
+	}
+	if (n) {
+		line[n] = 0;
+		printf("%s\n", line);
+	}
+}
+
 static void
 P875A02_log_start(void)
 {
@@ -800,7 +860,42 @@
 	if (P875A02_log_secs == 0 || P875A02_log_secs > 60) {
 		P875A02_log_secs = P875A02_LOG_SECS;
 	}
-	if (kernel_thread_start(P875A02_log_thread, NULL, &thread) == KERN_SUCCESS) {
+	/*
+	 * Self-test: show what the previous boot left, write a marker header,
+	 * read it back. Decides whether the log thread or the UFS write path is
+	 * the problem.
+	 */
+	uint64_t base = su.first_block + su.nblocks - P875A02_LOG_BLOCKS;
+	uint64_t tbase = base - 1;	/* spare block, keeps the real header intact */
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint32_t *w = (uint32_t *)bounce;
+	int err = ufs_read_blocks(tbase, 1);
+	printf("P875A02 LOG: pre rd=%d hdr %08x %08x %08x %08x\n", err, w[0], w[1], w[2], w[3]);
+	struct P875A02_log_header h = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+		.version = 1, .size = P875A02_LOG_SIZE, .total = 0, .seq = 0x5eed,
+	};
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &h, sizeof(h));
+	err = ufs_write_blocks(tbase, 1);
+	if (!err) {
+		err = ufs_sync_cache();
+	}
+	printf("P875A02 LOG: wr=%d\n", err);
+	err = ufs_read_blocks(tbase, 1);
+	printf("P875A02 LOG: post rd=%d hdr %08x %08x %08x %08x\n", err, w[0], w[1], w[2], w[3]);
+
+	uint32_t show = 0;
+	if (PE_parse_boot_argn("P875A02logshow", &show, sizeof(show)) && show) {
+		P875A02_log_show();
+		for (;;) {
+			(void)tsleep(&P875A02_log_chan, PZERO, "P875A02logshow", hz);
+		}
+	}
+
+	kern_return_t kr = kernel_thread_start(P875A02_log_thread, NULL, &thread);
+	printf("P875A02 LOG: thread start rc=%d\n", kr);
+	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
