P875A02: never touch CNTP_* - QHEE traps it as UNDEF.

Hardware panic: "Undefined kernel instruction ... instr=d51be228" at
_fiq_context_init+0x14, i.e. MSR CNTP_CTL_EL0 in _enable_virtual_timer().
The physical timer belongs to the hypervisor; XNU only uses CNTV.

--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2273,8 +2273,18 @@
 	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
 
 	__builtin_arm_wsr64("CNTV_CTL_EL0", cntvctl);
+#if defined(P875A02)
+	/*
+	 * QHEE traps every CNTP_* access from EL1 as UNDEF (confirmed on SM8350
+	 * by haydn and on this device: "Undefined kernel instruction ...
+	 * instr=d51be228" = MSR CNTP_CTL_EL0), so masking the physical timer
+	 * here would panic the kernel. The physical timer belongs to the
+	 * hypervisor and XNU only ever uses the virtual timer.
+	 */
+#else
 	/* disable the physical timer as a precaution, as its registers reset to architecturally unknown values */
 	__builtin_arm_wsr64("CNTP_CTL_EL0", CNTP_CTL_EL0_IMASKED);
+#endif
 }
 
 void
