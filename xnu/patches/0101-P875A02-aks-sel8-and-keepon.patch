 	bool          fPowerOff;      /* RequestPowerChange(0) */
+	bool          fKeepOn;        /* P875A02fb_keepon: ignore power off */
 	uint32_t      fFadeStep;      /* fade-out steps done while off */
 
 	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
@@ -221,6 +222,11 @@
 	}
 	uint32_t hz = 10;
 	PE_parse_boot_argn("P875A02fb_hz", &hz, sizeof(hz));
+	{
+		int keep = 0;
+		PE_parse_boot_argn("P875A02fb_keepon", &keep, sizeof(keep));
+		fKeepOn = keep != 0;
+	}
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 	fVsync->setTimeoutUS(P875A02_FB_VSYNC_US);
 
